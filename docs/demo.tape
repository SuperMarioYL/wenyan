Output assets/demo.gif
Set FontSize 13
Set Width 104
Set Height 38
Set Padding 16
Set Theme "Dracula"

Type "export TRANSFORMERS_VERBOSITY=error" Enter
Sleep 1

Type "wenyan --version" Enter
Sleep 2

Type "wenyan profile --suite" Enter
Sleep 9

Type "wenyan compress -p examples/sample_prompt.txt" Enter
Sleep 6
